{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jellyfin/.github//renovate-presets/dotnet"
  ],
  "packageRules": [
    {
      "description": "Keep Microsoft packages below v10 until the project targets .NET 10",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Microsoft\\./"
      ],
      "allowedVersions": "<10"
    }
  ]
}
